+    public function test_tv_cover_cache_separates_visibility_and_order_and_stores_only_integer_groups(): void
+    {
+        $this->createCoverCatalogSchema('videos');
+        DB::table('videos')->insert(['id' => 1, 'title' => 'Harbor', 'started' => '2024-01-01']);
+        DB::table('tv_episodes')->insert(['id' => 1, 'videos_id' => 1, 'series' => 1, 'episode' => 1, 'title' => 'First']);
+        $this->release('Harbor.S01E01', ['categories_id' => 5030, 'videos_id' => 1, 'tv_episodes_id' => 1]);
+        Schema::create('user_downloads', function (Blueprint $table): void {
+            $table->increments('id');
+            $table->unsignedInteger('releases_id');
+            $table->dateTime('timestamp');
+        });
+        $user = $this->browserUser();
+        $this->actingAs($user);
+        $entries = static fn (): array => array_filter(Cache::getStore()->all(), static fn (string $key): bool => str_starts_with($key, 'tv-cover-groups:'), ARRAY_FILTER_USE_KEY);
+        $this->get('/browse/tv?view=covers')->assertOk()->assertSee('Harbor.S01E01');
+        self::assertCount(1, $entries());
+        $payload = array_values($entries())[0]['value'];
+        self::assertSame(['total' => 1, 'groups' => [[1, 1]]], $payload);
+        array_walk_recursive($payload, static function (mixed $value): void {
+            self::assertIsInt($value);
+        });
+        $this->get('/browse/tv?view=covers&per=24&size=xl')->assertOk();
+        self::assertCount(1, $entries(), 'Page size and artwork size do not change group identity.');
+        foreach (['sort=posted', 'sort=grabs', 'sort=grabs&trending=1', 'year=2024'] as $index => $query) {
+            $this->get('/browse/tv?view=covers&'.$query)->assertOk();
+            self::assertCount($index + 2, $entries(), $query);
+        }
+        DB::table('user_excluded_categories')->insert(['users_id' => $user->id, 'categories_id' => 5030]);
+        Cache::forget($user::categoryExclusionCacheKey($user->id));
+        $this->get('/browse/tv?view=covers')->assertOk()->assertDontSee('Harbor.S01E01');
+        self::assertCount(6, $entries());
+        $other = $this->browserUser();
+        $this->flushSession();
+        $this->actingAs($other)->get('/browse/tv?view=covers')->assertOk()->assertSee('Harbor.S01E01');
+        self::assertCount(7, $entries());
+    }
