+    /** @return list<array{int, int}> */
+    private function orderedGroups(Builder $groups): array
+    {
+        /** @var Connection $connection */
+        $connection = $groups->getConnection();
+        $pdo = $connection->getPdo();
+        $mysql = in_array($connection->getDriverName(), ['mysql', 'mariadb'], true);
+        $buffered = $mysql ? $pdo->getAttribute(Mysql::ATTR_USE_BUFFERED_QUERY) : null;
+        if ($mysql) {
+            $pdo->setAttribute(Mysql::ATTR_USE_BUFFERED_QUERY, false);
+        }
+        try {
+            $ordered = [];
+            foreach ($groups->cursor() as $group) {
+                $ordered[] = [(int) $group->episode_id, (int) $group->release_count];
+            }
+
+            return $ordered;
+        } finally {
+            if ($mysql) {
+                $pdo->setAttribute(Mysql::ATTR_USE_BUFFERED_QUERY, $buffered);
+            }
+        }
+    }
