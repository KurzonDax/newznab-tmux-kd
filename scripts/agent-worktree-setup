#!/usr/bin/env bash

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=agent-workflow-lib
source "$script_directory/agent-workflow-lib"

agent_load_issue_worktree_context .

export AGENT_RUNTIME_SETUP=1
runtime_directory="$(git rev-parse --git-path agent-runtime)"
mkdir -p "$runtime_directory"
fingerprint="$(scripts/agent-runtime-state runtime)"
dependencies="$(scripts/agent-runtime-state dependencies)"
container_id="$(scripts/agent-sail ps -q laravel.test)"
if [[ -f "$runtime_directory/ready" && "$(cat "$runtime_directory/ready")" == "$fingerprint" && -n "$container_id" ]] &&
    [[ "$(docker inspect --format '{{.State.Running}}' "$container_id")" == true ]]; then
    exit 0
fi
mkdir "$runtime_directory/setup-lock" 2>/dev/null || agent_fail "runtime setup is already running or interrupted; inspect $runtime_directory/setup-lock before retrying"
trap 'rmdir "$runtime_directory/setup-lock"' EXIT
rm -f "$runtime_directory/ready"
git -C "$AGENT_WORKTREE_ROOT" ls-files --error-unmatch .env.testing >/dev/null 2>&1 ||
    agent_fail '.env.testing must be tracked'
grep -qx 'APP_ENV=testing' .env.testing || agent_fail 'testing APP_ENV is missing'
grep -qx 'DB_CONNECTION=testing' .env.testing || agent_fail 'testing database connection is missing'
grep -qx 'DB_DATABASE=:memory:' .env.testing || agent_fail 'in-memory testing database is missing'

scripts/agent-sail up -d --build
# These directories live only in this Compose project's disposable volumes/tmpfs.
scripts/agent-sail exec -T -u root laravel.test bash -c 'rm -rf /tmp/agent-cache; mkdir -p /tmp/agent-cache/views /var/www/html/storage/framework/{cache,sessions,views}; chown -R sail /tmp/agent-cache /var/www/html/vendor /var/www/html/node_modules /var/www/html/storage/framework /var/www/html/storage/logs'
if [[ ! -f "$runtime_directory/dependencies" || "$(cat "$runtime_directory/dependencies")" != "$dependencies" ]] ||
    ! scripts/agent-sail exec -T -u sail laravel.test test -f vendor/autoload.php; then
    scripts/agent-sail exec -T -u sail -e CAPTAINHOOK_DISABLE=true laravel.test composer install --no-interaction --prefer-dist
    scripts/agent-sail npm ci
    printf '%s' "$dependencies" > "$runtime_directory/dependencies"
fi

container_id="$(scripts/agent-sail ps -q laravel.test)"
[[ -n "$container_id" ]] || agent_fail 'isolated application container is not running'

container_project="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$container_id")"
[[ "$container_project" == "$AGENT_COMPOSE_PROJECT_NAME" ]] ||
    agent_fail "unexpected Compose project: $container_project"

source_mount="$(docker inspect --format '{{ range .Mounts }}{{ if eq .Destination "/var/www/html" }}{{ .Source }}{{ end }}{{ end }}' "$container_id")"
[[ -n "$source_mount" ]] || agent_fail 'application source mount is missing'
# Docker Desktop reports host bind sources with this VM prefix.
if [[ "$(uname -s)" == Darwin && "$source_mount" == /host_mnt/* ]]; then
    source_mount="${source_mount#/host_mnt}"
fi
source_mount="$(cd "$source_mount" && pwd -P)" || agent_fail 'could not resolve the application source mount'
[[ "$source_mount" == "$AGENT_WORKTREE_ROOT" ]] || agent_fail "unexpected source mount: $source_mount"

published_ports="$(docker port "$container_id")"
[[ -z "$published_ports" ]] || agent_fail 'issue application container must not publish ports'

# Expansion belongs to the container shell, not this host process.
# shellcheck disable=SC2016
scripts/agent-sail shell -lc 'test "$(pwd -P)" = /var/www/html && test -f composer.json'
# shellcheck disable=SC2016
scripts/agent-sail shell -lc 'test "$APP_ENV" = testing'
# shellcheck disable=SC2016
scripts/agent-sail shell -lc 'test "$(git rev-parse --show-toplevel)" = /var/www/html && git status --short >/dev/null'
scripts/agent-sail artisan config:show database.default | grep -q 'testing'
scripts/agent-sail exec -T -u sail laravel.test test -d vendor || agent_fail 'Composer dependencies are missing'
scripts/agent-sail exec -T -u sail laravel.test test -d node_modules || agent_fail 'npm dependencies are missing'

php_version="$(scripts/agent-sail php -r 'echo PHP_VERSION;')"
composer_version="$(scripts/agent-sail composer --version --no-ansi | sed -n '1p')"
node_version="$(scripts/agent-sail node --version)"

printf '%s' "$fingerprint" > "$runtime_directory/ready"
printf 'SETUP_STATUS=ready\n'
printf 'PHP_VERSION=%s\n' "$php_version"
printf 'COMPOSER_VERSION=%s\n' "$composer_version"
printf 'NODE_VERSION=%s\n' "$node_version"
printf 'SOURCE_MOUNT=%s\n' "$source_mount"
printf 'COMPOSE_PROJECT_NAME=%s\n' "$AGENT_COMPOSE_PROJECT_NAME"
