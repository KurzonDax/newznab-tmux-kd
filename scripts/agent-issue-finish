#!/usr/bin/env bash

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=agent-workflow-lib
source "$script_directory/agent-workflow-lib"

usage='usage: scripts/agent-issue-finish [--publish | --monitor [--timeout-seconds <n>]] [--no-merge]'

mode=full
timeout_seconds=''
expect_timeout_value=false
merge_when_green=true

for argument in "$@"; do
    if [[ "$expect_timeout_value" == true ]]; then
        timeout_seconds="$argument"
        expect_timeout_value=false
        continue
    fi
    case "$argument" in
        --publish)
            [[ "$mode" == full ]] || agent_fail "$usage"
            mode=publish
            ;;
        --monitor)
            [[ "$mode" == full ]] || agent_fail "$usage"
            mode=monitor
            ;;
        --timeout-seconds)
            expect_timeout_value=true
            ;;
        --timeout-seconds=*)
            timeout_seconds="${argument#--timeout-seconds=}"
            ;;
        --no-merge)
            merge_when_green=false
            ;;
        *)
            agent_fail "$usage"
            ;;
    esac
done
[[ "$expect_timeout_value" == false ]] || agent_fail "$usage"
if [[ -n "$timeout_seconds" ]]; then
    [[ "$mode" != publish ]] ||
        agent_fail '--timeout-seconds only applies to the monitor phase; drop it or use --monitor'
    [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] ||
        agent_fail '--timeout-seconds requires a positive integer'
fi

agent_load_issue_worktree_context .
agent_require_no_git_operation "$AGENT_WORKTREE_ROOT"

print_pull_request_status() {
    printf 'PR_NUMBER=%s\n' "$pull_request_number"
    printf 'PR_URL=%s\n' "$pull_request_url"
    printf 'MERGE_STATUS=%s\n' "$1"
}

dirty_files="$(git -C "$AGENT_WORKTREE_ROOT" status --porcelain --untracked-files=normal)"
if [[ -n "$dirty_files" ]]; then
    printf 'Uncommitted worktree changes:\n%s\n' "$dirty_files" >&2
    agent_fail 'commit the project files or delete the scratch files listed above, then rerun scripts/agent-issue-finish; do not end the session here'
fi

agent_fetch_origin_master "$AGENT_WORKTREE_ROOT" ||
    agent_fail 'could not fetch current origin/master; check network access, then rerun scripts/agent-issue-finish rather than ending the session'

pull_request_count="$(gh pr list --repo "$AGENT_EXPECTED_REPOSITORY" --state all \
    --head "$AGENT_ISSUE_BRANCH" --json number --jq 'length')"
[[ "$pull_request_count" -le 1 ]] ||
    agent_fail "multiple pull requests exist for $AGENT_ISSUE_BRANCH; ask the user which one to keep, close the others, then rerun scripts/agent-issue-finish"

pull_request_number="$(gh pr list --repo "$AGENT_EXPECTED_REPOSITORY" --state all \
    --head "$AGENT_ISSUE_BRANCH" --json number --jq '.[0].number // empty')"

# An old request must not be able to merge a newly pushed head using an unknown
# email. Disarm it before publication, including recovery of an existing PR.
if [[ -n "$pull_request_number" ]]; then
    existing_state="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" --json state --jq .state)"
    if [[ "$existing_state" == OPEN ]]; then
        auto_merge_armed="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" \
            --json autoMergeRequest --jq '.autoMergeRequest != null')"
        if [[ "$auto_merge_armed" == true ]]; then
            gh pr merge "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" --disable-auto
        fi
    fi
fi

if [[ "$mode" != monitor ]]; then
    ahead_count="$(git -C "$AGENT_WORKTREE_ROOT" rev-list --count origin/master..HEAD)"
    [[ "$ahead_count" -gt 0 ]] ||
        agent_fail 'the issue branch has no commits to publish; commit the completed work, then rerun scripts/agent-issue-finish'

    python3 "$script_directory/agent-verify" final --base origin/master

    agent_require_outgoing_identities
    git -C "$AGENT_WORKTREE_ROOT" push -u "$AGENT_REMOTE" "$AGENT_ISSUE_BRANCH"

    if [[ -z "$pull_request_number" ]]; then
        issue_title="$(gh issue view "$AGENT_ISSUE_NUMBER" --repo "$AGENT_EXPECTED_REPOSITORY" \
            --json title --jq .title)"
        pull_request_url="$(gh pr create --repo "$AGENT_EXPECTED_REPOSITORY" --base master \
            --head "$AGENT_ISSUE_BRANCH" --title "$issue_title" --body "Fixes #$AGENT_ISSUE_NUMBER")"
        pull_request_number="${pull_request_url##*/}"
    fi
else
    [[ -n "$pull_request_number" ]] ||
        agent_fail "no pull request exists for $AGENT_ISSUE_BRANCH; run scripts/agent-issue-finish --publish first"
fi

pull_request_url="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" \
    --json url --jq .url)"

pull_request_body="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" \
    --json body --jq .body)"
printf '%s\n' "$pull_request_body" | grep -Eq "(^|[[:space:]])Fixes[[:space:]]+#$AGENT_ISSUE_NUMBER([^0-9]|$)" ||
    agent_fail "pull request #$pull_request_number must contain: Fixes #$AGENT_ISSUE_NUMBER; edit its body with gh pr edit, then rerun scripts/agent-issue-finish"

pull_request_state="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" \
    --json state --jq .state)"
# Reject an unsafe outgoing commit before the monitor loop rather than at the
# merge call, so a rejection never depends on checks reaching success first.
if [[ "$pull_request_state" == OPEN ]]; then
    agent_require_outgoing_identities
fi

# An already merged request has nothing to opt out of, so --no-merge must not
# strand its cleanup; only publication still stops on a merged request.
if [[ ("$merge_when_green" == false && "$pull_request_state" != MERGED) || "$mode" == publish ]]; then
    if [[ "$pull_request_state" == MERGED ]]; then
        print_pull_request_status merged
        printf 'The pull request is already merged. Run scripts/agent-issue-finish --monitor to clean up the runtime and worktree.\n'
    elif [[ "$merge_when_green" == false ]]; then
        print_pull_request_status pending
        # A leading --option would be read as a printf flag, so print it as data.
        printf '%s\n' '--no-merge stopped this run at the open pull request. Rerun scripts/agent-issue-finish --monitor without it to merge and clean up.'
    else
        print_pull_request_status pending
        printf 'The pull request is open and unmerged. Run scripts/agent-issue-finish --monitor until it prints MERGE_STATUS=merged.\n'
    fi
    exit 0
fi

# GitHub can still be recomputing mergeability behind a green check result, so
# an unattributable refusal is retried before it becomes the maintainer's problem.
merge_refusal_limit=3
merge_refusals=0

monitor_deadline=''
if [[ -n "$timeout_seconds" ]]; then
    monitor_deadline=$((SECONDS + timeout_seconds))
fi

while true; do
    agent_load_issue_worktree_context .
    agent_require_no_git_operation "$AGENT_WORKTREE_ROOT"
    if [[ -n "$monitor_deadline" && "$SECONDS" -ge "$monitor_deadline" ]]; then
        print_pull_request_status pending
        printf 'The monitor window elapsed before merge. Rerun scripts/agent-issue-finish --monitor until it prints MERGE_STATUS=merged.\n'
        exit 0
    fi

    pull_request_snapshot="$("$script_directory/agent-check-snapshot" "$AGENT_EXPECTED_REPOSITORY" "$pull_request_number")" ||
        agent_fail "could not read a consistent required-check snapshot for pull request #$pull_request_number; check the GitHub API error above, then rerun scripts/agent-issue-finish --monitor"
    snapshot_fields="$(printf '%s' "$pull_request_snapshot" | jq -er \
        '[.state, .mergeStateStatus, .reviewDecision, .checksStatus, .headRefOid] | @tsv')" ||
        agent_fail 'invalid required-check snapshot; rerun scripts/agent-issue-finish --monitor'
    IFS=$'\t' read -r pull_request_state merge_state review_decision checks_status snapshot_head <<<"$snapshot_fields"

    if [[ "$pull_request_state" == MERGED ]]; then
        break
    fi
    [[ "$pull_request_state" == OPEN ]] ||
        agent_fail "pull request #$pull_request_number closed without merging; inspect it on GitHub with the user, reopen it or restart, then rerun scripts/agent-issue-finish"

    case "$review_decision" in
        CHANGES_REQUESTED|REVIEW_REQUIRED)
            agent_fail "pull request #$pull_request_number is waiting on review; address the review (an unexpected REVIEW_REQUIRED usually means the commit author email is not attributed to a GitHub account), then rerun scripts/agent-issue-finish --monitor"
            ;;
    esac

    case "$merge_state" in
        BEHIND)
            agent_require_clean_checkout "$AGENT_WORKTREE_ROOT"
            agent_fetch_origin_master "$AGENT_WORKTREE_ROOT" ||
                agent_fail 'could not refresh origin/master; check network access, then rerun scripts/agent-issue-finish --monitor rather than ending the session'
            agent_require_effective_identity
            if ! git -C "$AGENT_WORKTREE_ROOT" merge --no-edit origin/master; then
                    agent_fail 'origin/master conflicts with the issue branch; merge origin/master in the issue worktree, resolve the conflicts, commit, then rerun scripts/agent-issue-finish --monitor'
            fi
            agent_require_outgoing_identities
            git -C "$AGENT_WORKTREE_ROOT" push "$AGENT_REMOTE" "$AGENT_ISSUE_BRANCH"
            continue
            ;;
        DIRTY)
            agent_fail 'the pull request conflicts with master; merge origin/master in the issue worktree, resolve the conflicts, commit, then rerun scripts/agent-issue-finish --monitor'
            ;;
    esac

    case "$checks_status" in
        failure)
            agent_fail "current required checks failed or were cancelled for pull request #$pull_request_number; fix the failure or rerun the current required workflow, then rerun scripts/agent-issue-finish --monitor"
            ;;
        pending)
            sleep 10
            ;;
        success)
            agent_require_outgoing_identities
            if gh pr merge "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" --squash \
                --author-email "$AGENT_APPROVED_EMAIL" \
                --match-head-commit "$(git -C "$AGENT_WORKTREE_ROOT" rev-parse HEAD)"; then
                merge_refusals=0
            else
                # A peer pull request can merge between the green snapshot and
                # this call, leaving this one BEHIND on stale checks. Classify
                # the refusal from the re-read state, never from gh's wording.
                refusal_fields="$(gh pr view "$pull_request_number" --repo "$AGENT_EXPECTED_REPOSITORY" \
                    --json state,mergeStateStatus,headRefOid --jq '[.state, .mergeStateStatus, .headRefOid] | @tsv')" ||
                    agent_fail "could not merge pull request #$pull_request_number, and could not re-read its state to classify the refusal; check the GitHub API error above, then rerun scripts/agent-issue-finish --monitor"
                IFS=$'\t' read -r refused_state refused_merge_state refused_head <<<"$refusal_fields"
                if [[ "$refused_state" != OPEN || "$refused_head" != "$snapshot_head" ||
                    "$refused_merge_state" == BEHIND || "$refused_merge_state" == DIRTY ]]; then
                    # The request moved on; the loop's own cases own the new state.
                    merge_refusals=0
                else
                    merge_refusals=$((merge_refusals + 1))
                    [[ "$merge_refusals" -lt "$merge_refusal_limit" ]] ||
                        agent_fail "GitHub refused to merge pull request #$pull_request_number $merge_refusals times while it stayed $refused_merge_state on an unchanged head; read the merge error above, resolve it on GitHub, then rerun scripts/agent-issue-finish --monitor"
                fi
            fi
            # Only GitHub's MERGED state permits cleanup, even after a merge call.
            sleep 5
            ;;
        *)
            agent_fail 'unknown required-check state; inspect the snapshot helper before retrying'
            ;;
    esac
done

# Verify the server-created author before cleanup. GitHub's service committer is
# separate from the maintainer author and must not pass the local-commit policy.
merge_commit="$(gh api "repos/$AGENT_EXPECTED_REPOSITORY/pulls/$pull_request_number" \
    --jq .merge_commit_sha 2>/dev/null)" || agent_fail 'could not resolve merged commit for identity verification'
[[ "$merge_commit" =~ ^[0-9a-f]{40}$ ]] || agent_fail 'invalid merged commit identifier'
for field in name email; do
    expected="$AGENT_APPROVED_NAME"
    [[ "$field" != email ]] || expected="$AGENT_APPROVED_EMAIL"
    server_author_approved="$(gh api "repos/$AGENT_EXPECTED_REPOSITORY/commits/$merge_commit" \
        --jq ".commit.author.$field == \"$expected\"" 2>/dev/null)" ||
        agent_fail "could not verify commit $merge_commit author.$field (value redacted)"
    [[ "$server_author_approved" == true ]] ||
        agent_fail "commit $merge_commit has unapproved author.$field (value redacted); checkout preserved for investigation"
done
printf 'MERGE_AUTHOR=approved\n'

# Cleanup is deliberately scoped to this worktree's Compose label, remote branch,
# registered linked worktree, and local issue branch.
# Deferred prose-only tasks may never have started Docker.
if [[ -d "$(git rev-parse --git-path agent-runtime)" ]] ||
    { [[ "$AGENT_CHECKOUT_MODE" == worktree ]] && ! agent_has_checkout_owner "$AGENT_WORKTREE_ROOT" "$AGENT_COMMON_GIT_DIRECTORY"; }; then
    scripts/agent-sail down --remove-orphans --volumes
fi
if agent_remote_branch_exists "$AGENT_WORKTREE_ROOT" "$AGENT_ISSUE_BRANCH"; then
    git -C "$AGENT_WORKTREE_ROOT" push "$AGENT_REMOTE" --delete "$AGENT_ISSUE_BRANCH"
fi

# Recheck immediately before cleanup; never discard user edits made while monitoring.
agent_require_clean_checkout "$AGENT_WORKTREE_ROOT"
owned=false
if agent_has_checkout_owner "$AGENT_WORKTREE_ROOT" "$AGENT_COMMON_GIT_DIRECTORY"; then
    owned=true
fi
if [[ "$AGENT_CHECKOUT_MODE" == primary ]]; then
    git -C "$AGENT_WORKTREE_ROOT" -c core.hooksPath=/dev/null switch master
else
    cleanup_parent="$(dirname "$AGENT_WORKTREE_ROOT")"
    cd "$cleanup_parent"
    git --git-dir="$AGENT_COMMON_GIT_DIRECTORY" worktree remove "$AGENT_WORKTREE_ROOT"
fi
git --git-dir="$AGENT_COMMON_GIT_DIRECTORY" branch -D "$AGENT_ISSUE_BRANCH"
if [[ "$owned" == true ]]; then
    python3 "$AGENT_PRIMARY_CHECKOUT/scripts/agent-checkout" release "$AGENT_WORKTREE_ROOT" "$AGENT_COMMON_GIT_DIRECTORY" "$AGENT_ISSUE_NUMBER"
fi

# The merge is done, so a failed or skipped sync must never fail the finish.
primary_master_status=skipped
if [[ "$(git -C "$AGENT_PRIMARY_CHECKOUT" symbolic-ref --quiet --short HEAD 2>/dev/null)" == master &&
    -z "$(git -C "$AGENT_PRIMARY_CHECKOUT" status --porcelain --untracked-files=no)" ]]; then
    if git -C "$AGENT_PRIMARY_CHECKOUT" pull --ff-only "$AGENT_REMOTE" master; then
        primary_master_status=synced
    else
        primary_master_status=sync-failed
    fi
fi

print_pull_request_status merged
if [[ "$AGENT_CHECKOUT_MODE" == worktree ]]; then
    printf 'REMOVED_WORKTREE=%s\n' "$AGENT_WORKTREE_ROOT"
else
    printf 'PRESERVED_CHECKOUT=%s\n' "$AGENT_WORKTREE_ROOT"
fi
printf 'REMOVED_BRANCH=%s\n' "$AGENT_ISSUE_BRANCH"
printf 'PRIMARY_MASTER=%s\n' "$primary_master_status"
if [[ "$primary_master_status" != synced ]]; then
    printf 'Local master was not fast-forwarded; run git pull --ff-only in the primary checkout when it is clean and on master.\n'
fi
