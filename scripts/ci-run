#!/usr/bin/env python3
"""Execute manifest suite IDs; acceptance requires an explicit --acceptance invocation."""
import argparse
import json
from pathlib import Path
import sys
import time

from ci_runtime import container_command, run, sail


def execute(suites, policy, acceptance):
    if suites:
        run(container_command(['python3', 'scripts/ci-inventory'], 40), 50)
    database = clients = False
    for name in suites:
        suite = policy['suites'][name]
        if suite['category'] == 'acceptance' and not acceptance:
            raise ValueError(f'{name} requires explicit --acceptance')
        seconds = suite['seconds']
        print(f'::group::{name} ({seconds}s budget)', flush=True)
        if suite['environment'] in ['mariadb', 'backup'] and not database:
            run([sail(), 'up', '-d', '--wait', 'mariadb'], 90)
            database = True
        if suite['environment'] == 'clients' and not clients:
            run(container_command(['bash', 'tests/Support/ObfuscationRecovery/install-clients.sh'], 90, user='root'), 100)
            clients = True
        if suite.get('files'):
            env = {'CBP_INTEGRATION_DB_DATABASE': 'cbp_integration',
                   'CBP_INTEGRATION_DB_USERNAME': 'sail', 'CBP_INTEGRATION_DB_PASSWORD': 'password'}
            if suite['environment'] == 'backup':
                env['BACKUP_INTEGRATION_MARIADB'] = '1'
            command = ['scripts/run-tests-isolated.sh', 'php', 'artisan', 'test', '--compact',
                       '--fail-on-skipped', '--fail-on-warning', '--fail-on-empty-test-suite', *suite['files']]
            for group in suite.get('exclude_groups', []):
                command += ['--exclude-group', group]
            for key in ['group', 'filter']:
                if key in suite:
                    command += ['--' + key, suite[key]]
            run(container_command(command, seconds, env), seconds + 10)
        else:
            deadline = time.monotonic() + seconds
            for command in suite['commands']:
                command = list(command)
                if command[0] == './sail':
                    command[0] = sail()
                if command[0] == 'make':
                    command += ['SAIL=' + sail()]
                run(command, max(1, deadline - time.monotonic()))
        print('::endgroup::', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('suites', nargs='*')
    parser.add_argument('--lane', type=int, choices=[0, 1])
    parser.add_argument('--plan')
    parser.add_argument('--all-correctness', action='store_true')
    parser.add_argument('--acceptance', action='store_true')
    args = parser.parse_args()
    policy = json.loads(Path('.github/ci-policy.json').read_text())
    suites = args.suites
    if args.all_correctness:
        suites = [key for key, suite in policy['suites'].items() if suite['category'] != 'acceptance']
    if args.lane is not None:
        suites = json.loads(args.plan)['lanes'][args.lane]
    execute(suites, policy, args.acceptance)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, RuntimeError) as error:
        print(f'CI execution: {error}', file=sys.stderr)
        sys.exit(1)
