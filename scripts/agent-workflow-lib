#!/usr/bin/env bash

# These globals are consumed by the executable scripts that source this file.
# shellcheck disable=SC2034
AGENT_EXPECTED_ORIGIN='https://github.com/KurzonDax/newznab-tmux-kd.git'
AGENT_EXPECTED_REPOSITORY='KurzonDax/newznab-tmux-kd'
AGENT_REMOTE='origin'

agent_fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 2
}

agent_require_issue_number() {
    local issue_number="$1"

    [[ "$issue_number" =~ ^[1-9][0-9]*$ ]] || agent_fail 'issue number must be a positive integer'
}

agent_repository_root() {
    local starting_path="${1:-.}"

    git -C "$starting_path" rev-parse --show-toplevel 2>/dev/null
}

agent_common_git_directory() {
    local repository_root="$1"
    local git_directory

    git_directory="$(git -C "$repository_root" rev-parse --git-common-dir 2>/dev/null)" || return 1
    if [[ "$git_directory" != /* ]]; then
        git_directory="$(cd "$repository_root/$git_directory" && pwd -P)" || return 1
    fi

    printf '%s\n' "$git_directory"
}

agent_primary_checkout() {
    local common_git_directory="$1"

    git --git-dir="$common_git_directory" worktree list --porcelain |
        awk '/^worktree / { print substr($0, 10); exit }'
}

agent_expected_worktree_path() {
    local primary_checkout="$1"
    local issue_number="$2"
    local primary_parent

    primary_parent="$(cd "$(dirname "$primary_checkout")" && pwd -P)" || return 1
    printf '%s/worktrees/issue-%s\n' "$primary_parent" "$issue_number"
}

agent_compose_project_name() {
    local worktree_root="$1"
    local worktree_name
    local path_checksum

    worktree_name="$(basename "$worktree_root" | tr '[:upper:]_' '[:lower:]-' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//')"
    [[ -n "$worktree_name" ]] || return 1
    path_checksum="$(printf '%s' "$worktree_root" | cksum | awk '{ print $1 }')"

    printf 'nntmux-%s-%s\n' "$worktree_name" "$path_checksum"
}

agent_validate_origin() {
    local repository_root="$1"
    local origin_url

    origin_url="$(git -C "$repository_root" remote get-url "$AGENT_REMOTE" 2>/dev/null)" ||
        agent_fail "missing Git remote: $AGENT_REMOTE"
    [[ "$origin_url" == "$AGENT_EXPECTED_ORIGIN" ]] ||
        agent_fail "unexpected origin remote: $origin_url"
}

agent_fetch_origin_master() {
    local repository_root="$1"
    local attempt=1
    local error_file

    error_file="$(mktemp "${TMPDIR:-/tmp}/agent-fetch.XXXXXXXX")" || return 1

    while true; do
        if git -C "$repository_root" fetch --no-write-fetch-head "$AGENT_REMOTE" \
            '+refs/heads/master:refs/remotes/origin/master' 2>"$error_file"; then
            rm -f -- "$error_file"
            return 0
        fi

        if [[ "$attempt" -ge 4 ]] ||
            ! grep -Eq 'cannot lock ref|Unable to create.*lock|another git process' "$error_file"; then
            cat "$error_file" >&2
            rm -f -- "$error_file"
            return 1
        fi

        printf 'Shared Git ref is locked; retrying fetch (%s/4).\n' "$attempt" >&2
        attempt=$((attempt + 1))
        sleep "$attempt"
    done
}

agent_local_branch_exists() {
    local common_git_directory="$1"
    local branch="$2"

    git --git-dir="$common_git_directory" show-ref --verify --quiet "refs/heads/$branch"
}

agent_remote_branch_exists() {
    local repository_root="$1"
    local branch="$2"
    local status=0

    git -C "$repository_root" ls-remote --exit-code --heads "$AGENT_REMOTE" "refs/heads/$branch" \
        >/dev/null 2>&1 || status=$?

    case "$status" in
        0)
            return 0
            ;;
        2)
            return 1
            ;;
        *)
            agent_fail "could not inspect remote branch: $branch"
            ;;
    esac
}

agent_branch_worktree_path() {
    local common_git_directory="$1"
    local branch="$2"

    git --git-dir="$common_git_directory" worktree list --porcelain |
        awk -v branch_ref="refs/heads/$branch" '
            /^worktree / { path = substr($0, 10) }
            /^branch / && $2 == branch_ref { print path; exit }
        '
}

agent_load_issue_worktree_context() {
    local requested_root="${1:-.}"
    local expected_worktree

    AGENT_WORKTREE_ROOT="$(agent_repository_root "$requested_root")" ||
        agent_fail 'not inside a Git worktree'
    AGENT_WORKTREE_ROOT="$(cd "$AGENT_WORKTREE_ROOT" && pwd -P)" ||
        agent_fail 'could not resolve worktree root'
    [[ "$(pwd -P)" == "$AGENT_WORKTREE_ROOT" ]] ||
        agent_fail 'run this command from the issue worktree root'
    [[ -f "$AGENT_WORKTREE_ROOT/.git" ]] ||
        agent_fail 'the current checkout is not a linked worktree'

    AGENT_ISSUE_BRANCH="$(git -C "$AGENT_WORKTREE_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
        agent_fail 'the issue worktree must have a checked-out branch'
    [[ "$AGENT_ISSUE_BRANCH" == issue/* ]] ||
        agent_fail "expected an issue/<number> branch, found: $AGENT_ISSUE_BRANCH"
    AGENT_ISSUE_NUMBER="${AGENT_ISSUE_BRANCH#issue/}"
    agent_require_issue_number "$AGENT_ISSUE_NUMBER"

    AGENT_COMMON_GIT_DIRECTORY="$(agent_common_git_directory "$AGENT_WORKTREE_ROOT")" ||
        agent_fail 'could not resolve the common Git directory'
    AGENT_PRIMARY_CHECKOUT="$(agent_primary_checkout "$AGENT_COMMON_GIT_DIRECTORY")" ||
        agent_fail 'could not resolve the primary checkout'
    [[ -n "$AGENT_PRIMARY_CHECKOUT" ]] || agent_fail 'could not resolve the primary checkout'
    AGENT_PRIMARY_CHECKOUT="$(cd "$AGENT_PRIMARY_CHECKOUT" && pwd -P)" ||
        agent_fail 'could not resolve the primary checkout path'

    expected_worktree="$(agent_expected_worktree_path "$AGENT_PRIMARY_CHECKOUT" "$AGENT_ISSUE_NUMBER")" ||
        agent_fail 'could not derive the issue worktree path'
    [[ "$AGENT_WORKTREE_ROOT" == "$expected_worktree" ]] ||
        agent_fail "unexpected issue worktree path: $AGENT_WORKTREE_ROOT"

    agent_validate_origin "$AGENT_WORKTREE_ROOT"
    # shellcheck disable=SC2034
    AGENT_COMPOSE_PROJECT_NAME="$(agent_compose_project_name "$AGENT_WORKTREE_ROOT")" ||
        agent_fail 'could not derive the Compose project name'
}
