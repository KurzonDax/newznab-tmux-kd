#!/usr/bin/env python3
"""Persistent checkout ownership, independent of GitHub account and runtime state."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import sys


def record_path(root, common):
    return Path(common) / 'agent-checkouts' / hashlib.sha256(str(Path(root).resolve()).encode()).hexdigest()


def session():
    value = os.environ.get('AGENT_SESSION_ID') or os.environ.get('CODEX_THREAD_ID') or os.environ.get('CLAUDE_SESSION_ID')
    if not value:
        raise ValueError('set a unique AGENT_SESSION_ID for this task; retain it for interrupted-session recovery')
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['reserve', 'check', 'release'])
    parser.add_argument('root')
    parser.add_argument('common')
    parser.add_argument('issue')
    parser.add_argument('--recover', action='store_true')
    args = parser.parse_args()
    directory = record_path(args.root, args.common)
    record = directory / 'owner.json'
    expected = dict(session=session(), issue=args.issue, root=str(Path(args.root).resolve()))
    if args.action == 'reserve' and not args.recover:
        directory.parent.mkdir(parents=True, exist_ok=True)
        try:
            directory.mkdir()
        except FileExistsError:
            raise ValueError(f'checkout is owned; inspect {record} and recover only its interrupted task')
        record.write_text(json.dumps(expected) + '\n')
    else:
        try:
            owner = json.loads(record.read_text())
        except (OSError, ValueError):
            raise ValueError(f'checkout ownership is missing or incomplete: {record}; preserve state and report it')
        if owner != expected:
            raise ValueError(f'checkout is owned by another task: {record}; a shared GitHub account is not ownership')
        if args.action == 'release':
            record.unlink()
            directory.rmdir()
    print(f'CHECKOUT_OWNER={expected["session"]}')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        sys.exit(f'ERROR: {error}')
