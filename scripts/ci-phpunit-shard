#!/usr/bin/env python3
"""Partition installed PHPUnit discovery without changing its configuration."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--index', type=int, required=True)
    parser.add_argument('--count', type=int, required=True)
    args = parser.parse_args()
    if args.count < 1 or not 0 <= args.index < args.count:
        parser.error('index must be in [0, count), with a positive count')
    cache = os.environ.get('PHPUNIT_CACHE_DIRECTORY')
    if not cache:
        parser.error('run this command through scripts/run-tests-isolated.sh')

    discovery = subprocess.run(['php', 'vendor/bin/phpunit', '--configuration', 'phpunit.xml',
                                '--list-test-files'], check=True, capture_output=True, text=True)
    root = Path.cwd().resolve()
    files = []
    header = False
    for line in discovery.stdout.splitlines():
        if not line:
            continue
        if not header and re.fullmatch(r'PHPUnit 12\.[0-9.]+ by Sebastian Bergmann and contributors\.', line):
            continue
        if not header and line == 'Available test files:':
            header = True
            continue
        if not header or not line.startswith(' - '):
            raise ValueError(f'unexpected PHPUnit discovery output: {line!r}')
        path = Path(line[3:])
        if not path.is_absolute() or not path.is_file() or path.suffix != '.php':
            raise ValueError(f'unexpected discovered file: {path}')
        relative = path.resolve().relative_to(root).as_posix()
        if relative in files:
            raise ValueError(f'duplicate discovered file: {relative}')
        files.append(relative)
    if not header or not files:
        raise ValueError('PHPUnit discovery selected no files')
    files.sort(key=os.fsencode)
    selected = files[args.index::args.count]
    if not selected:
        raise ValueError('empty shard')
    print(f'Shard {args.index + 1}/{args.count}: {len(selected)} of {len(files)} files', flush=True)
    return subprocess.call(['php', 'artisan', 'test', '--compact',
                            '--cache-directory', cache, '--fail-on-empty-test-suite', *selected])


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'PHPUnit shard failed: {error}', file=sys.stderr)
        sys.exit(1)
