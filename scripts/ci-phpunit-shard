#!/usr/bin/env python3
"""Partition installed PHPUnit discovery without changing its configuration."""
import argparse
import os
import json
import math
import statistics
import tempfile
import time
import xml.etree.ElementTree as ET
from pathlib import Path
import re
import subprocess
import sys


def allocate(files, count):
    path = Path('.github/phpunit-costs.json')
    measured = json.loads(path.read_text())['files'] if path.exists() else {}
    measured = {name: cost for name, cost in measured.items() if name in files}
    if any(isinstance(cost, bool) or not isinstance(cost, (int, float))
           or not math.isfinite(cost) or cost <= 0 for cost in measured.values()):
        raise ValueError('file costs must be positive finite seconds')
    fallback = statistics.median(measured.values()) if measured else 1.0
    shards, totals = [[] for _ in range(count)], [0.0] * count
    for name in sorted(files, key=lambda name: (-measured.get(name, fallback), name)):
        index = totals.index(min(totals))
        shards[index].append(name)
        totals[index] += measured.get(name, fallback)
    return shards, totals


def report_costs(report, root):
    totals = {}
    # PHPUnit records each case's setup and teardown in its time attribute.
    # Aggregate cases, not nested suite totals (which would double count).
    def visit(element, owner=None):
        if element.tag == 'testsuite':
            owner = element.get('file') or owner
        if element.tag == 'testcase':
            filename = owner or element.get('file')
            if filename:
                relative = Path(filename).resolve().relative_to(root).as_posix()
                totals[relative] = totals.get(relative, 0.0) + float(element.get('time', '0'))
        for child in element:
            visit(child, owner)
    visit(ET.parse(report).getroot())
    print('PHPUNIT_FILE_SECONDS=' + json.dumps(
        {name: round(seconds, 6) for name, seconds in sorted(totals.items())}, sort_keys=True), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--index', type=int, required=True)
    parser.add_argument('--count', type=int, required=True)
    args = parser.parse_args()
    if args.count < 1 or not 0 <= args.index < args.count:
        parser.error('index must be in [0, count), with a positive count')
    cache = os.environ.get('PHPUNIT_CACHE_DIRECTORY')
    if not cache:
        parser.error('run this command through scripts/run-tests-isolated.sh')

    discovery = subprocess.run(['php', 'vendor/bin/phpunit', '--configuration', 'phpunit.xml',
                                '--list-test-files'], check=True, capture_output=True, text=True)
    root = Path.cwd().resolve()
    files = []
    header = False
    for line in discovery.stdout.splitlines():
        if not line:
            continue
        if not header and re.fullmatch(r'PHPUnit 12\.[0-9.]+ by Sebastian Bergmann and contributors\.', line):
            continue
        if not header and line == 'Available test files:':
            header = True
            continue
        if not header or not line.startswith(' - '):
            raise ValueError(f'unexpected PHPUnit discovery output: {line!r}')
        path = Path(line[3:])
        if not path.is_absolute() or not path.is_file() or path.suffix != '.php':
            raise ValueError(f'unexpected discovered file: {path}')
        relative = path.resolve().relative_to(root).as_posix()
        if relative in files:
            raise ValueError(f'duplicate discovered file: {relative}')
        files.append(relative)
    if not header or not files:
        raise ValueError('PHPUnit discovery selected no files')
    shards, estimates = allocate(files, args.count)
    selected = shards[args.index]
    if not selected:
        raise ValueError('empty shard')
    print(f'Shard {args.index + 1}/{args.count}: {len(selected)} of {len(files)} files', flush=True)
    print(f'Estimated test seconds: {estimates[args.index]:.2f}', flush=True)
    with tempfile.TemporaryDirectory(prefix='phpunit-costs-') as directory:
        report = str(Path(directory) / 'junit.xml')
        started = time.monotonic()
        result = subprocess.call(['php', 'artisan', 'test', '--compact',
                                  '--cache-directory', cache, '--fail-on-empty-test-suite',
                                  '--log-junit', report, *(selected if args.count > 1 else [])])
        print(f'SHARD_TEST_SECONDS={time.monotonic() - started:.2f}', flush=True)
        if Path(report).exists():
            report_costs(report, root)
        elif result == 0:
            raise ValueError('successful test run did not produce JUnit costs')
        return result


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, ET.ParseError, subprocess.CalledProcessError) as error:
        print(f'PHPUnit shard failed: {error}', file=sys.stderr)
        sys.exit(1)
