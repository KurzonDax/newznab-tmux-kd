#!/usr/bin/env python3
"""One local verification owner for focused work, final checks, hooks and publication."""
import argparse
import fnmatch
import hashlib
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

from ci_runtime import container_command, run


def git(*args):
    return subprocess.check_output(['git', *args]).decode().strip()


def files():
    output = subprocess.check_output(['git', 'ls-files', '--cached', '--others', '--exclude-standard', '-z']).decode()
    return sorted(set(filter(None, output.split('\0'))))


def digest(command, inputs, identity):
    value = hashlib.sha256(json.dumps([command, identity], sort_keys=True).encode())
    for filename in sorted(set(inputs)):
        path = Path(filename)
        value.update(filename.encode() + b'\0')
        if path.is_file():
            value.update(str(path.stat().st_mode & 0o777).encode() + b'\0')
            value.update(path.read_bytes())
        else:
            value.update(b'<missing>')
    return value.hexdigest()


def checked(key, command, seconds, inputs, identity='', container=False):
    directory = Path(git('rev-parse', '--git-path', 'agent-verification'))
    directory.mkdir(parents=True, exist_ok=True)
    fingerprint = digest(command, inputs, identity)
    receipt = directory / (hashlib.sha256(key.encode()).hexdigest() + '.json')
    try:
        previous = json.loads(receipt.read_text())
    except (OSError, ValueError):
        previous = {}
    if previous.get('fingerprint') == fingerprint and previous.get('success') is True:
        print(f'VERIFY_REUSED={key}', flush=True)
        return
    receipt.unlink(missing_ok=True)
    execute = container_command(command, seconds) if container and not Path('/.dockerenv').exists() else command
    elapsed = run(execute, seconds + (10 if container else 0))
    if fingerprint != digest(command, inputs, identity):
        raise ValueError(f'{key} changed its inputs; review/restage changes and run verification again')
    temporary = receipt.with_suffix('.tmp')
    temporary.write_text(json.dumps(dict(fingerprint=fingerprint, success=True, seconds=elapsed, command=command)))
    temporary.replace(receipt)


def application_command(command):
    return command if Path('/.dockerenv').exists() else container_command(command, 30)


def runtime_identity():
    return subprocess.check_output(application_command(['php', '-v']), text=True) + subprocess.check_output(application_command(['node', '--version']), text=True)


def changed(base):
    paths = subprocess.check_output(['git', 'diff', '--name-only', '--no-renames', '-z', base]).decode().split('\0')
    paths += subprocess.check_output(['git', 'ls-files', '--others', '--exclude-standard', '-z']).decode().split('\0')
    return sorted(set(filter(None, paths)))


def final_checks(args):
    paths = changed(args.base)
    php = [path for path in paths if path.endswith('.php') and not path.endswith('.blade.php') and Path(path).is_file()]
    frontend = any(path.startswith('resources/') or fnmatch.fnmatchcase(path, 'vite.config.*') or path in ['package.json', 'package-lock.json'] for path in paths)
    plan = dict(php_files=php, frontend=frontend, paths=paths)
    if args.mode == 'plan':
        print(json.dumps(plan))
        return
    subprocess.run([sys.executable, 'scripts/ci-preflight', '--base', args.base], check=True, stdout=subprocess.DEVNULL)
    if args.mode == 'hook':
        staged = set(subprocess.check_output(['git', 'diff', '--cached', '--name-only', '-z']).decode().split('\0'))
        unstaged = set(subprocess.check_output(['git', 'diff', '--name-only', '-z']).decode().split('\0'))
        if (staged & unstaged) - {''}:
            raise ValueError('staged/unstaged versions differ; stage the intended verified version before committing')
    inputs = [p for p in files() if not p.endswith('.md') and not p.startswith('docs/')]
    inputs += ['.env', '.env.testing']
    php_affecting = any(p.endswith('.php') or p in ['composer.json', 'composer.lock', 'phpunit.xml'] or p.startswith(('bootstrap/', 'config/')) for p in paths)
    identity = runtime_identity() if php_affecting or frontend else sys.version
    identity += git('rev-parse', args.base)
    if php:
        checked('pint', ['php', 'vendor/bin/pint', '--repair', *php], 90, php + ['pint.json', 'composer.lock'], identity, True)
        for path in php:
            checked('lint:' + path, ['php', '-l', path], 10, [path], identity, True)
    if php_affecting:
        checked('phpstan', ['php', 'vendor/bin/phpstan', 'analyse', '--memory-limit=2G'], 180, inputs, identity, True)
    if any(p in ['composer.json', 'composer.lock'] for p in paths):
        checked('composer-lock', ['composer', 'validate', '--no-check-publish'], 30, ['composer.json', 'composer.lock'], identity, True)
    checked('source-permissions', ['bash', 'scripts/runtime-permissions.sh', 'check-source'], 30, inputs, identity)
    if frontend:
        checked('design', ['bash', 'scripts/check-design-system.sh'], 30, inputs, identity)
        checked('build', ['npm', 'run', 'build'], 120, inputs, identity, True)
        checked('js', ['npm', 'run', 'test:js'], 30, inputs, identity, True)
    if any(p.startswith(('scripts/', 'tests/Shell/', '.github/')) or p == 'captainhook.json' for p in paths):
        for filename in ['CiPolicyTest.py', 'AgentVerifyTest.py', 'CiContractsTest.py']:
            checked(filename, ['python3', 'tests/Shell/' + filename], 30, inputs, identity)
    changed_tests = [p for p in php if p.startswith('tests/') and p.endswith('Test.php')]
    # Final verification reuses explicitly selected focused measurements; never starts an unbounded full test file here.
    for path in changed_tests:
        patch = git('diff', '--unified=0', args.base, '--', path)
        edits = [line[1:].strip() for line in patch.splitlines() if line[:1] in ['+', '-'] and not line.startswith(('+++', '---'))]
        if edits and all(not line or line.startswith("#[Group(") or line == 'use PHPUnit\\Framework\\Attributes\\Group;' for line in edits):
            continue  # Moving existing acceptance selectors is checked without rerunning large fixtures.
        if not measurement_covers(path, args.base, inputs, identity):
            raise ValueError(f'{path} requires a bounded focused run: scripts/agent-verify focused --test {path} [--filter METHOD]')
    behavioral_inputs = [p for p in paths if p in ['tests/TestCase.php', 'tests/CreatesApplication.php'] or p.startswith(('app/', 'routes/', 'tests/Support/', 'tests/Fixtures/', 'tests/mock_data/'))]
    if behavioral_inputs and not list(measurements(inputs, identity)):
        raise ValueError('changed application/shared fixture inputs require a focused behavioral measurement')
    print('VERIFY_STATUS=passed')


def measurements(inputs, identity):
    directory = Path(git('rev-parse', '--git-path', 'agent-verification'))
    for record in directory.glob('focused-*.json'):
        try:
            data = json.loads(record.read_text())
            if data.get('success') is True and data['fingerprint'] == digest(data['command'], inputs, identity):
                yield data
        except (OSError, ValueError, KeyError):
            continue


def changed_methods(path, base):
    source = Path(path).read_text().splitlines()
    regions = []
    for index, line in enumerate(source):
        match = re.match(r'^(\s*)public function (test_\w+)\(', line)
        if not match:
            continue
        end = index if '{' in line and '}' in line else None
        for following in range(index + 1, len(source)) if end is None else []:
            if source[following].rstrip() == match[1] + '}':
                end = following
                break
        if end is None:
            return None
        regions.append((index + 1, end + 1, match[2]))
    tests = {name for _, _, name in regions}
    if not tests:
        return None  # Attribute-named tests or ambiguous setup require an unfiltered file measurement.
    patch = git('diff', '--unified=0', base, '--', path)
    if not patch:
        return tests  # Untracked test file.
    required = set()
    for first, count in re.findall(r'@@ -[0-9,]+ \+(\d+)(?:,(\d+))? @@', patch):
        for line in range(int(first), int(first) + max(1, int(count or '1'))):
            containing = [name for start, end, name in regions if start <= line <= end]
            name = containing[0] if len(containing) == 1 else None
            if name not in tests:
                return None
            required.add(name)
    return required


def measurement_covers(path, base, inputs, identity):
    relevant = [data for data in measurements(inputs, identity) if data['test'] == path]
    if any(data.get('unfiltered') for data in relevant):
        return True
    required = changed_methods(path, base)
    covered = {case['name'].split(' with data set')[0] for data in relevant if data.get('complete_methods') for case in data.get('cases', [])}
    return required is not None and bool(required) and required <= covered


def focused(args):
    if not args.test or not Path(args.test).is_file():
        raise ValueError('focused requires an existing --test file')
    inputs = [p for p in files() if not p.endswith('.md') and not p.startswith('docs/')] + ['.env', '.env.testing']
    identity = runtime_identity() + git('rev-parse', args.base)
    specialist = args.test.startswith('tests/Integration/')
    limit = 120 if specialist else 30
    with tempfile.TemporaryDirectory(prefix='agent-focused-', dir='storage') as directory:
        report = str(Path(directory) / 'results.xml')
        command = ['scripts/run-tests-isolated.sh', 'php', 'artisan', 'test', '--compact', '--fail-on-empty-test-suite',
                   '--fail-on-warning', '--fail-on-skipped', args.test, '--log-junit', report]
        if args.filter:
            command += ['--filter', args.filter]
        if args.exclude_group:
            command += ['--exclude-group', args.exclude_group]
        env = {'CBP_INTEGRATION_DB_DATABASE': 'cbp_integration', 'CBP_INTEGRATION_DB_USERNAME': 'sail',
               'CBP_INTEGRATION_DB_PASSWORD': 'password'} if specialist else {}
        receipt_command = [part for part in command if part not in ['--log-junit', report]]
        before = digest(receipt_command, inputs, identity)
        if Path('/.dockerenv').exists():
            elapsed = run(command, 180, env={**os.environ, **env})
        else:
            elapsed = run(container_command(command, 180, env), 190)
        cases = list(ET.parse(report).iter('testcase'))
        if not cases or any(float(case.get('time', '0')) > limit for case in cases):
            raise ValueError(f'focused cases exceed the {limit}s admission budget')
        command = receipt_command
        if before != digest(command, inputs, identity):
            raise ValueError('focused inputs changed during execution; no success recorded')
        measured_cases = [dict(name=case.get('name'), seconds=float(case.get('time', '0'))) for case in cases]
    directory = Path(git('rev-parse', '--git-path', 'agent-verification'))
    directory.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(json.dumps(command).encode()).hexdigest()
    (directory / ('focused-' + key + '.json')).write_text(json.dumps(dict(test=args.test, command=command, success=True, seconds=elapsed, cases=measured_cases,
                                              unfiltered=not args.filter and not args.exclude_group,
                                              complete_methods=bool(args.filter and re.fullmatch(r'test_\w+(?:\|test_\w+)*', args.filter)) and not args.exclude_group, fingerprint=before)))
    print('FOCUSED_STATUS=passed')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['plan', 'final', 'hook', 'focused', 'run', 'evidence'])
    parser.add_argument('--base', default='origin/master')
    parser.add_argument('--key')
    parser.add_argument('--inputs', nargs='*', default=[])
    parser.add_argument('--seconds', type=float, default=180)
    parser.add_argument('--test')
    parser.add_argument('--filter')
    parser.add_argument('--exclude-group')
    argv = sys.argv[1:]
    split = argv.index('--') if '--' in argv else len(argv)
    args = parser.parse_args(argv[:split])
    if args.mode == 'run':
        if not args.key or not argv[split + 1:]:
            raise ValueError('run requires --key and -- command')
        checked(args.key, argv[split + 1:], args.seconds, args.inputs, sys.version)
    elif args.mode == 'evidence':
        inputs = [p for p in files() if not p.endswith('.md') and not p.startswith('docs/')] + ['.env', '.env.testing']
        identity = runtime_identity() + git('rev-parse', args.base)
        if not measurement_covers(args.test, args.base, inputs, identity):
            raise ValueError('changed tests have not all been measured')
        print('EVIDENCE_STATUS=passed')
    elif args.mode == 'focused':
        focused(args)
    else:
        final_checks(args)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f'Verification: {error}', file=sys.stderr)
        sys.exit(1)
